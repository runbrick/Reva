{
  "info": {"name": "Legacy API", "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"},
  "auth": {"type": "basic", "basic": {"username": "{{user}}", "password": "secret"}},
  "variable": [{"key": "baseUrl", "value": "https://example.test"}],
  "item": [
    {"name": "Basic", "request": {"method": "GET", "url": "{{baseUrl}}/basic", "header": "Accept: application/json\r\nX-Test: yes"}},
    {"name": "Bearer", "request": {"method": "GET", "url": "{{baseUrl}}/bearer", "auth": {"type": "bearer", "bearer": {"token": "{{token}}"}}}},
    {"name": "API key", "request": {"method": "GET", "url": "{{baseUrl}}/key", "auth": {"type": "apikey", "apikey": {"key": "X-API-Key", "value": "{{key}}", "in": "header"}}}}
  ]
}
