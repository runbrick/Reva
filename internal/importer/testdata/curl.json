  {"name":"get moves data to query", "command":"curl -G 'https://example.test/search?fixed=yes' -d 'tag=one' --data-urlencode 'q=a b' -d 'tag=two'", "want":{"method":"GET","url":"https://example.test/search","params":[{"key":"fixed","value":"yes"},{"key":"tag","value":"one"},{"key":"q","value":"a b"},{"key":"tag","value":"two"}]}},
